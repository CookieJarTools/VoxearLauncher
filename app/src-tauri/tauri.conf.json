{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voxear Launcher",
  "version": "0.1.0",
  "identifier": "com.cookiejar.voxear.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voxear Launcher",
        "width": 1120,
        "height": 720,
        "minWidth": 820,
        "minHeight": 520,
        "decorations": false,
        "backgroundColor": "#131417"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "CookieJarTools",
    "homepage": "https://github.com/CookieJarTools/VoxearLauncher",
    "shortDescription": "Installs Voxear engine versions and manages Voxear projects",
    "category": "DeveloperTool",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
